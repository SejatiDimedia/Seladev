    "clean": "turbo run clean && rm -rf node_modules packages/*/node_modules apps/*/node_modules"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "turbo": "^1.13.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.1.0"
}
