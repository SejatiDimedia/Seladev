{
  "name": "seladev-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SELADEV — Internal Developer Platform (IDP) Monorepo",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
