# Server Config
PORT=4000
NODE_ENV=development

# Database Config
MONGO_URI=mongodb://root:examplepassword@localhost:27017/seladev?authSource=admin

# Redis Config
REDIS_URI=redis://localhost:6379
REDIS_PASSWORD=exampleredispassword

# Security Keys
# In production, use RSA keys (PEM format) with at least 2048-bit length.
# For local development, you can use any secure strings.
JWT_PRIVATE_KEY="dev-jwt-private-key-secure-enough-placeholder-value-to-pass-validation"
JWT_PUBLIC_KEY="dev-jwt-public-key-secure-enough-placeholder-value-to-pass-validation"

# Master Encryption Key for secrets at rest (AES-256-GCM requires a 32-character key)
MASTER_ENCRYPTION_KEY="example_master_encryption_key_32"
